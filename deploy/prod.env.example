# Prod stack env. Copy to prod.env (never committed): cp prod.env.example prod.env
# Up (from deploy/): docker compose -p runnix-prod --env-file prod.env -f compose.prod.yaml up -d

# Public hostnames Caddy serves (each needs an A-record). The Caddy stack
# reads both domains (its up command passes both env files), so keep both
# set here and mirrored in dev.env.example.
API_DOMAIN=api.runnix.xyz
DEV_DOMAIN=dev.runnix.xyz

# Pin to a release tag in prod (e.g. IMAGE_TAG=vX.Y.Z), never a floating tag.
IMAGE_TAG=vX.Y.Z

POSTGRES_USER=runnix
# Generate: openssl rand -hex 24 (hex stays URL-safe inside DATABASE_URL).
POSTGRES_PASSWORD=
POSTGRES_DB=runnix

# Generate: openssl rand -hex 32. Required: ENV=production refuses to boot without it.
JWT_SECRET=
# Webhook HMAC key (generate like JWT_SECRET). Empty leaves webhook signing off.
WEBHOOK_SIGNING_SECRET=
